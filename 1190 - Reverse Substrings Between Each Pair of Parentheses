class Solution {
    public String reverseParentheses(String s) {

        //TC = O(n)
        //SC = O(n)
        
        int n = s.length();
        int[] link = new int[n];
        Stack<Integer> stack = new Stack<>();

        for(int i = 0; i < n; i++) {
            char c = s.charAt(i);
            if(c == '(')
                stack.push(i);
            else if(c == ')') {
                int j = stack.pop();
                link[i] = j;
                link[j] = i;
            }    
        }

        StringBuilder result = new StringBuilder();
        for(int i = 0, direction = 1; i < n; i += direction) {
            if(s.charAt(i) >= 'a')
                result.append(s.charAt(i));
            else 
            {
                i = link[i];
                direction = -direction;
            }    
        }
        return result.toString();    
    }
}

