class Solution {
    public boolean checkValidString(String s) {

        /*
            Step1 => Left to right replace all * to (
            Step2 => Right to left replace all * to )
            Step3 => At any point of time if open or close count is < 0 return false
        */

        //TC = O(n)
        //SC = O(1)

        int n = s.length();
        for(int i = 0, open = 0; i < n; i++) {
            char c = s.charAt(i);
            if(c == '(' || c == '*')
                open++;
            else
                open--;

            //We have more close parenthesis even after using all * as open    
            if(open < 0) return false;
        }

        for(int i = n-1, close = 0; i >= 0; i--) {
            char c = s.charAt(i);
            if(c == ')' || c == '*')
                close++;
            else
                close--;

            //We have more open parenthesis even after using all * as close        
            if(close < 0) return false;
        }
        return true;
    }
}
