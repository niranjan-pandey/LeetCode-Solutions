class Solution {
    public boolean isRectangleOverlap(int[] r1, int[] r2) {

        /*

                c_______________d
        a_______________b

        Overlap condition
        a < d && c < b

        Same condition is applied in 2D plane
        */


        //TC = O(1)
        //SC = O(1)

        boolean way1 = r1[0] < r2[2] && r1[1] < r2[3];
        boolean way2 = r2[0] < r1[2] && r2[1] < r1[3];
        
        return way1 && way2;
    }
}
