class Solution {
    public int minimizeSum(int[] nums) {

        //TC = O(Sort)
        //SC = O(Sort)
        
        Arrays.sort(nums);
        int n = nums.length;

        int way1 = nums[n-2]-nums[1];
        int way2 = nums[n-3]-nums[0];
        int way3 = nums[n-1]-nums[2];

        return Math.min(way1, Math.min(way2, way3));
    }
}
