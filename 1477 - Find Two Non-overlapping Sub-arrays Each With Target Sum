class Solution {
    public int minSumOfLengths(int[] nums, int target) {

        //TC = O(n)
        //SC = O(n)

        int n = nums.length;
        int[] left = new int[n];
        Arrays.fill(left, Integer.MAX_VALUE);
         
        int result = Integer.MAX_VALUE;
        int minLen = Integer.MAX_VALUE;
        for(int start = 0, end = 0, curSum = 0; end < n; end++) {
            curSum += nums[end];
            while(start < end && curSum > target) 
                curSum -= nums[start++];
            if(curSum == target) {
                int curLen = end-start+1;
                if(start > 0 && left[start-1] != Integer.MAX_VALUE)
                    result = Math.min(result, curLen + left[start-1]);
                minLen = Math.min(curLen, minLen);    
            }   
            left[end] = minLen;
        }
        return result == Integer.MAX_VALUE ? -1 : result;
    }
}
