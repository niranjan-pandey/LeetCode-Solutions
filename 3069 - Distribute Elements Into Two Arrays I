class Solution {
    public int[] resultArray(int[] nums) {

        //TC = O(n)
        //SC = O(n)
        
        List<Integer> A = new ArrayList<>(); 
        List<Integer> B = new ArrayList<>(); 

        A.add(nums[0]); 
        B.add(nums[1]);

        int n = nums.length;
        for(int i = 2; i < nums.length; ++i) {
            if(A.get(A.size()-1) > B.get(B.size()-1)) 
                A.add(nums[i]);
            else 
                B.add(nums[i]);
        }

        int rIdx = 0;
        for(int num : A) nums[rIdx++] = num;
        for(int num : B) nums[rIdx++] = num;

        return nums;      
    }
}
