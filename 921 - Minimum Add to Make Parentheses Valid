class Solution {
    public int minAddToMakeValid(String s) {

        //TC = O(n)
        //SC = O(1)

        int open = 0;
        int result = 0;

        int n = s.length();
        for(int i = 0; i < n; i++) {
            open += s.charAt(i) == '(' ? 1 : -1;
            if(open < 0) {
                open = 0;
                result++;
            }
        }
        return result + open;
    }
}
