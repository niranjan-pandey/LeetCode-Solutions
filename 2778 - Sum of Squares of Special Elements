class Solution {
    public int sumOfSquares(int[] nums) {

        //TC = O(n)
        //SC = O(1)
        
        int result = 0;
        int n = nums.length;
        for(int i = 1; i <= n; i++) 
            if(i % n == 0 || n % i == 0)
                result += (nums[i-1] * nums[i-1]);

        return result;        
    }
}
