class Solution {
    public int minOperations(int[] nums, int X) {

        //Step1 => TotalSum of array
        //Step2 => Target = totalSum - X
        //Step3 => Length of Longest subarray equals to target = L
        //Step4 => result = n - L (Step3)

        //TC = O(n)
        //SC = O(1)
        
        int n = nums.length;
        int totalSum = Arrays.stream(nums).sum();
        int target = totalSum - X;

        if(totalSum < X)
            return -1;

        if(totalSum == X)
            return n;    

        int curSum = 0;
        int result = 0;
        for(int start = 0, end = 0; end < n; end++) {
            curSum += nums[end];
            while(curSum > target)
                curSum -= nums[start++];

            if(curSum == target)
                result = Math.max(result, end-start+1);
        }
        return result == 0 ? -1 : n-result;
    }
}
