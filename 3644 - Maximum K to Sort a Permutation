class Solution {
    public int sortPermutation(int[] nums) {

        //TC = O(n)
        //SC = O(1)

        int result = -1;
        int n = nums.length;
        for(int i = 0; i < n; i++) {
            if(nums[i] != i) 
                result &= nums[i];
            if(result == 0)
                return 0;    
        }
        return Math.max(0, result);
    }
}
