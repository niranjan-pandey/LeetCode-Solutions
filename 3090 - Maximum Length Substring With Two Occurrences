class Solution {
    public int maximumLengthSubstring(String s) {

        //TC = O(n)
        //SC = O(26)

        int[] freq = new int[26];
        char[] S = s.toCharArray();

        int result = 0;
        int n = S.length;
        for(int start = 0, end = 0; end < n; ++end) {
            freq[S[end]-'a']++;
            while(freq[S[end]-'a'] > 2)
                --freq[S[start++]-'a'];
            result = Math.max(result, end-start+1);
        }
        return result;
    }
}
