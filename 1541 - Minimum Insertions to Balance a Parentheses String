class Solution {
    public int minInsertions(String s) {

        //TC = O(n)
        //SC = O(1)

        int open = 0;
        int close = 0;
        int result = 0;

        int n = s.length();
        for(int i = 0; i < n; i++) {
            char c = s.charAt(i);
            if(c == '(')
            {
                if(close == 1) 
                {
                    if(open > 0) 
                    {
                        open--;
                        result++;
                    }
                    else
                        result += 2;    
                    close = 0;
                }
                open++;
            } 
            else 
            {
                close++;
                if(close == 2) 
                {
                    if(open > 0)
                        open--;
                    else
                        result++;
                    close -= 2;
                }  
            }    
        }

        if(open > 0)
            return result + (2*open-close); // CASE : ((((
        else
            return result + (2*close); // CASE : single close [)]
    }
}
