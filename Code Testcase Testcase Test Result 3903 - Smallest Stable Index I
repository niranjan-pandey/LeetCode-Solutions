class Solution {
    public int firstStableIndex(int[] nums, int K) {

        //TC = O(n^2)
        //SC = O(1)

        int lMax = 0;
        int rMin = 0;

        int n = nums.length;
        for(int i = 0; i < n; ++i) {
            rMin = nums[i];
            lMax = Math.max(nums[i], lMax);
            for(int j = i; j < n; ++j) 
                rMin = Math.min(rMin, nums[j]);
            if(lMax-rMin <= K)
                return i;
        }
        return -1;
    }
}
