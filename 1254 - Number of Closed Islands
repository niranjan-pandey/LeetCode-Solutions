class Solution {
    int n, m;
    public int closedIsland(int[][] grid) {

        //TC = O(n*m)
        //SC = O(n*m) //Recursion Depth
        
        n = grid.length;
        m = grid[0].length;

        for(int i = 0; i < n; i++) 
            for(int j = 0; j < m; j++) 
                if(grid[i][j] == 0 && (i == 0 || i == n-1 || j == 0 || j == m-1)) 
                    dfs(i, j, grid);
      
        int result = 0;
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < m; j++) { 
                if(grid[i][j] == 0) {
                    result++;
                    dfs(i, j, grid);
                }
            }
        }                
        return result;
    }

    private void dfs(int row, int col, int[][] grid) {
        if(row < 0 || row == n || col < 0 || col == m || grid[row][col] == 1)
            return;

        grid[row][col] = 1;    
        dfs(row+1, col, grid);
        dfs(row-1, col, grid);
        dfs(row, col+1, grid);
        dfs(row, col-1, grid);
    }
}
