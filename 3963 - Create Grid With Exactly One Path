class Solution {
    public String[] createGrid(int n, int m) { 

        //TC = O(n*m)
        //SC = O(n*m)

        char[][] grid = new char[n][m];
        for(char[] row : grid)
            Arrays.fill(row, '#');

        for(int i = 0; i < n; i++)
            grid[i][0] = '.';

        for(int j = 0; j < m; j++)
            grid[n-1][j] = '.';   

        String[] result = new String[n];
        for(int i = 0; i < n; i++)
            result[i] = new String(grid[i]);  

        return result;    
    }
}
