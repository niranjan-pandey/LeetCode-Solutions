class Solution {
    public boolean canAliceWin(int n) {

        //TC = O(1)
        //SC = O(1)

        int bob = 9;
        int alice = 10;

        while(n > 0) {

            if(n < alice) return false;

            n -= alice;
            alice -= 2;

            if(n < bob) return true;

            n -= bob;
            bob -= 2;
        }
        return false;
    }
}
