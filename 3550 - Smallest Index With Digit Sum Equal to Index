class Solution {
    public int smallestIndex(int[] nums) {

        //TC = O(n*log(n))
        //SC = O(1)
        
        int n = nums.length;
        for(int i = 0; i < n; i++) 
            if(getDigitSum(nums[i]) == i)
                return i;
        return -1;
    }
    
    private int getDigitSum(int n) {
        int result = 0;
        while(n > 0) {
            result += (n % 10);
            n /= 10;
        }
        return result;
    }
}
