Solution 1 => Stack
class Solution {
    public int longestValidParentheses(String s) {

        //TC = O(n)
        //SC = O(n)
        
        Stack<Integer> stack = new Stack<>();
        stack.push(-1);

        int result = 0;    
        int n = s.length();
        for(int i = 0; i < n; ++i) {
            if(s.charAt(i) == '(')
                stack.push(i);
            else
            {
                stack.pop();
                if(stack.isEmpty())
                    stack.push(i);
                else
                    result = Math.max(result, i-stack.peek());    
            }
        } 
        return result;
    }
}

//Solution 2 => With Variables
class Solution {
    public int longestValidParentheses(String s) {

        //TC = O(n)
        //SC = O(1)
        
        int open = 0;
        int close = 0;

        int result = 0;

        //Left to right check
        int n = s.length();
        for(int i = 0; i < n; i++) {
            char c = s.charAt(i);
            if(c == '(')
                open++;
            else
                close++;

            if(open == close)
                result = Math.max(result, open+close);    
            else if(close > open) 
                open = close = 0;
        }

        //Right to left check for edge cases like "()(()"
        open = close = 0;
        for(int i = n-1; i >= 0; i--) {
            char c = s.charAt(i);
            if(c == '(')
                open++;
            else
                close++;

            if(open == close)
                result = Math.max(result, open+close);    
            else if(open > close) 
                open = close = 0;
        }
        return result;
    }
}
