class Solution {
    public int largestOverlap(int[][] A, int[][] B) {

        //TC = O(n^4)
        //SC = O(1)

        int n = A.length;
        int maxOverlap = 0;
        for(int rowOff = -n+1; rowOff < n; rowOff++) {
            for(int colOff = -n+1; colOff < n; colOff++) {
                int curOverlap = solve(A, B, rowOff, colOff, n);
                maxOverlap = Math.max(curOverlap, maxOverlap);
            }
        }
        return maxOverlap;
    }

    private int solve(int[][] A, int[][] B, int rowOff, int colOff, int n) {
        int cntOverlap = 0;
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < n; j++) {
                int bI = i + rowOff;
                int bJ = j + colOff;

                if(bI < 0 || bI >= n || bJ < 0 || bJ >= n)
                    continue;

                if(A[i][j] == 1 && B[bI][bJ] == 1)
                    cntOverlap++;    
            }
        }
        return cntOverlap;
    }
}
