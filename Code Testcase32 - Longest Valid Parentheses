class Solution {
    public int longestValidParentheses(String s) {

        //TC = O(n)
        //SC = O(n)
        
        Stack<Integer> stack = new Stack<>();
        stack.push(-1);

        int result = 0;    
        int n = s.length();
        for(int i = 0; i < n; ++i) {
            if(s.charAt(i) == '(')
                stack.push(i);
            else
            {
                stack.pop();
                if(stack.isEmpty())
                    stack.push(i);
                else
                    result = Math.max(result, i-stack.peek());    
            }
        } 
        return result;
    }
}
