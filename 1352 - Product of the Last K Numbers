class ProductOfNumbers {
    List<Integer> A;
    public ProductOfNumbers() {
        A = new ArrayList();
        A.add(1);
    }
    
    public void add(int num) {
        if(num > 0)
            A.add(A.get(A.size()-1) * num);
        else
        {
            A = new ArrayList();
            A.add(1);
        }    
    }
    
    public int getProduct(int K) {
        int n = A.size();
        return K < n ? (A.get(n-1) / A.get(n-K-1)) : 0;
    }
}
