class Solution {
    public int minSwaps(int[] nums) {

        //TC = O(n*log(n))
        //SC = O(n)

        int n = nums.length;
        Map<Integer,Integer> map = new HashMap<>();
        for(int i = 0; i < n; i++)
            map.put(nums[i], i);

        PriorityQueue<int[]> pq = new PriorityQueue<>((x, y) -> x[1] == y[1] ? x[0]-y[0] : x[1]-y[1]);
        for(int i = 0; i < n; i++)
            pq.add(new int[]{nums[i], digitSum(nums[i])});

        int result = 0;
        for(int i = 0; i < n; i++) {
            int num = pq.remove()[0];
            if(nums[i] == num)
                continue;

            result++;
            int Idx = map.get(num);
            int temp = nums[i];
            nums[i] = nums[Idx];
            nums[Idx] = temp;

            map.remove(nums[i]);
            map.put(nums[Idx], Idx);
        }
        return result; 
    }

    private int digitSum(int n) {
        int result = 0;
        while(n > 0) {
            result = result + (n % 10);
            n /= 10;
        }
        return result;
    }
}
