class Solution {
    public int maxDepth(String s) {

        //TC = O(n)
        //SC = O(1)
        
        int result = 0;
        int n = s.length();
        for(int i = 0, depth = 0; i < n; i++) {
            if(s.charAt(i) == '(')
                depth++;
            else if(s.charAt(i) == ')') 
                depth--;
            result = Math.max(result, depth);       
        }
        return result;
    }
}
