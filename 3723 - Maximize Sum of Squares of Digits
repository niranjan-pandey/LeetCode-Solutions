class Solution {
    public String maxSumOfSquares(int num, int sum) {
        
        //TC = O(num)
        //SC = O(1)
        
        if(sum > 9L * num)
           return "";
        
        StringBuilder result = new StringBuilder();
        
        int q = sum / 9;
        int r = sum % 9;
        
        for(int i = 1; i <= q; i++)
            result.append('9');
        
        if(r > 0)
            result.append((char)('0'+r));
        
        for(int i = q + (r > 0 ? 1 : 0); i < num; i++)    
            result.append('0');
        
        return result.toString();
    }
}
